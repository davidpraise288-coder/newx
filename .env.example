# OpenChat Plugin Configuration
# Copy this file to .env and fill in your values

# OpenChat Canister ID (required)
# Get this from the OpenChat team or from the IC dashboard
OPENCHAT_CANISTER_ID=your-openchat-canister-id-here

# Internet Computer Host (optional, defaults to https://ic0.app)
OPENCHAT_HOST=https://ic0.app

# Identity file path (optional, will generate if not provided)
# This file will store the agent's IC identity
OPENCHAT_IDENTITY_PATH=./openchat-identity.json

# Polling configuration
OPENCHAT_POLLING_ENABLED=true
OPENCHAT_POLLING_INTERVAL=5000

# Feature flags
OPENCHAT_ENABLE_DIRECT_MESSAGES=true
OPENCHAT_ENABLE_GROUP_CHATS=true
OPENCHAT_ENABLE_COMMUNITIES=false
OPENCHAT_ENABLE_CRYPTO=false
OPENCHAT_ENABLE_POLLS=true
OPENCHAT_ENABLE_MEDIA=true

# Agent configuration
OPENCHAT_AGENT_NAME=ElizaOS Agent
OPENCHAT_AGENT_DISPLAY_NAME=ElizaOS Agent

# Retry configuration
OPENCHAT_RETRY_TIMES=3
OPENCHAT_RETRY_DELAY=1000

# Debug settings
OPENCHAT_DEBUG=false
OPENCHAT_LOG_LEVEL=info