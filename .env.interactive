# Interactive OpenChat Agent Configuration
# This configuration enables real-time message response

# OpenChat Canister (REQUIRED - get from OpenChat team)
OPENCHAT_CANISTER_ID=your-openchat-canister-id-here

# Internet Computer Network
OPENCHAT_HOST=https://ic0.app

# Identity for the agent
OPENCHAT_IDENTITY_PATH=./interactive-agent-identity.json

# IMPORTANT: Enable polling for message detection
OPENCHAT_POLLING_ENABLED=true
OPENCHAT_POLLING_INTERVAL=5000  # Check every 5 seconds

# Response features
OPENCHAT_ENABLE_DIRECT_MESSAGES=true
OPENCHAT_ENABLE_GROUP_CHATS=true
OPENCHAT_ENABLE_COMMUNITIES=false

# Agent personality
OPENCHAT_AGENT_NAME=OpenChat Assistant
OPENCHAT_AGENT_DISPLAY_NAME=AI Assistant

# Performance for interactive use
OPENCHAT_RETRY_TIMES=3
OPENCHAT_RETRY_DELAY=1000

# Debug (enable to see message flow)
OPENCHAT_DEBUG=true
OPENCHAT_LOG_LEVEL=info