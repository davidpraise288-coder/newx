# OpenChat Plugin Test Configuration
# Test environment canister IDs for development

# TEST OPENCHAT CANISTERS
OPENCHAT_CANISTER_ID=7njde-waaaa-aaaaf-ab2ca-cai  # user_index (test)
OPENCHAT_GROUP_CANISTER_ID=7kifq-3yaaa-aaaaf-ab2cq-cai  # group_index (test)

# Internet Computer Network
OPENCHAT_HOST=https://ic0.app

# Identity Management
OPENCHAT_IDENTITY_PATH=./test-identity.json

# Polling Configuration (Faster for testing)
OPENCHAT_POLLING_ENABLED=true
OPENCHAT_POLLING_INTERVAL=5000  # 5 seconds for testing

# Feature Configuration (All enabled for testing)
OPENCHAT_ENABLE_DIRECT_MESSAGES=true
OPENCHAT_ENABLE_GROUP_CHATS=true
OPENCHAT_ENABLE_COMMUNITIES=false  # Limited in test environment
OPENCHAT_ENABLE_CRYPTO=false
OPENCHAT_ENABLE_POLLS=true
OPENCHAT_ENABLE_MEDIA=false  # Disable for faster testing

# Agent Configuration
OPENCHAT_AGENT_NAME=Test OpenChat Agent
OPENCHAT_AGENT_DISPLAY_NAME=Test AI Assistant

# Performance Tuning (Faster retries for testing)
OPENCHAT_RETRY_TIMES=3
OPENCHAT_RETRY_DELAY=1000

# Debug Settings (Enabled for testing)
OPENCHAT_DEBUG=true
OPENCHAT_LOG_LEVEL=debug