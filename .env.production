# OpenChat Plugin Production Configuration
# Real OpenChat canister IDs from the official deployment

# PRODUCTION OPENCHAT CANISTERS
OPENCHAT_CANISTER_ID=4bkt6-4aaaa-aaaaf-aaaiq-cai  # user_index (main messaging)
OPENCHAT_GROUP_CANISTER_ID=4ijyc-kiaaa-aaaaf-aaaja-cai  # group_index (group management)

# Alternative canisters for different functionality
# OPENCHAT_CANISTER_ID=nq4qv-wqaaa-aaaaf-bhdgq-cai  # local_user_index
# OPENCHAT_CANISTER_ID=dobi3-tyaaa-aaaaf-adnna-cai  # notifications

# Internet Computer Network
OPENCHAT_HOST=https://ic0.app

# Identity Management
OPENCHAT_IDENTITY_PATH=./production-identity.json

# Polling Configuration (Production)
OPENCHAT_POLLING_ENABLED=true
OPENCHAT_POLLING_INTERVAL=10000  # 10 seconds for production

# Feature Configuration
OPENCHAT_ENABLE_DIRECT_MESSAGES=true
OPENCHAT_ENABLE_GROUP_CHATS=true
OPENCHAT_ENABLE_COMMUNITIES=true
OPENCHAT_ENABLE_CRYPTO=false  # Enable if you need crypto features
OPENCHAT_ENABLE_POLLS=true
OPENCHAT_ENABLE_MEDIA=true

# Agent Configuration
OPENCHAT_AGENT_NAME=ElizaOS OpenChat Agent
OPENCHAT_AGENT_DISPLAY_NAME=AI Assistant

# Performance Tuning (Production)
OPENCHAT_RETRY_TIMES=5
OPENCHAT_RETRY_DELAY=2000

# Security & Logging
OPENCHAT_DEBUG=false
OPENCHAT_LOG_LEVEL=warn