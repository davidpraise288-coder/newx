{
  "name": "@elizaos/plugin-openchat",
  "version": "1.0.0",
  "description": "OpenChat plugin for ElizaOS agents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:plugin": "ts-node scripts/test-plugin.ts",
    "test:mock": "ts-node scripts/run-with-mock.ts",
    "watch": "nodemon --exec ts-node src/index.ts",
    "setup:dev": "chmod +x scripts/dev-setup.sh && ./scripts/dev-setup.sh",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "type-check": "tsc --noEmit",
    "example:basic": "ts-node examples/basic-usage.ts",
    "example:advanced": "ts-node examples/advanced-usage.ts",
    "example:interactive": "ts-node examples/interactive-agent-setup.ts",
    "deploy:local": "dfx deploy --local",
    "deploy:ic": "dfx deploy --network ic"
  },
  "keywords": ["elizaos", "openchat", "plugin", "internet-computer", "agent"],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@dfinity/agent": "^0.20.0",
    "@dfinity/candid": "^0.20.0",
    "@dfinity/principal": "^0.20.0",
    "@dfinity/identity": "^0.20.0",
    "@dfinity/auth-client": "^0.20.0",
    "@elizaos/core": "latest",
    "typescript": "^5.0.0",
    "ws": "^8.14.0",
    "uuid": "^9.0.0",
    "dotenv": "^16.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.0",
    "ts-node": "^10.9.0",
    "nodemon": "^3.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0"
  },
  "peerDependencies": {
    "@elizaos/core": "*"
  }
}